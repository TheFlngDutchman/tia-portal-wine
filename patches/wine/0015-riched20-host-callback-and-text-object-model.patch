+/* paragraph format of the range a paragraph object is attached to */
+static HRESULT textpara_get_fmt(ITextParaImpl *para, PARAFORMAT2 *fmt)
+{
+    const struct text_services *services;
+    LONG start, end;
+
+    if (!para->range || !(services = get_range_reole(para->range)))
+        return CO_E_RELEASED;
+
+    ITextRange_GetStart(para->range, &start);
+    ITextRange_GetEnd(para->range, &end);
+    memset(fmt, 0, sizeof(*fmt));
+    fmt->cbSize = sizeof(*fmt);
+    editor_get_range_para_fmt(services->editor, start, end, fmt);
+    return S_OK;
+}
+
+static HRESULT textpara_set_fmt(ITextParaImpl *para, PARAFORMAT2 *fmt)
+{
+    const struct text_services *services;
+    LONG start, end;
+
+    if (!para->range || !(services = get_range_reole(para->range)))
+        return CO_E_RELEASED;
+
+    ITextRange_GetStart(para->range, &start);
+    ITextRange_GetEnd(para->range, &end);
+    fmt->cbSize = sizeof(*fmt);
+    editor_set_range_para_fmt(services->editor, start, end, fmt);
+    return S_OK;
+}
