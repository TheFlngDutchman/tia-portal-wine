+static void editor_get_range_paras( ME_TextEditor *editor, int start, int end, ME_Paragraph **para, ME_Paragraph **para_end )
+{
+    ME_Cursor from, to;
+
+    cursor_from_char_ofs( editor, start, &from );
+    cursor_from_char_ofs( editor, end, &to );
+    *para = from.para;
+    *para_end = to.para;
+    /* as for a selection, a range ending at the start of a paragraph excludes it */
+    if (*para != *para_end && !to.run->nCharOfs && !to.nOffset) *para_end = para_prev( *para_end );
+}
+
+/* set the format of the paragraphs covered by a range of characters */
+BOOL editor_set_range_para_fmt( ME_TextEditor *editor, int start, int end, const PARAFORMAT2 *fmt )
+{
+    ME_Paragraph *para, *para_end;
+
+    editor_get_range_paras( editor, start, end, &para, &para_end );
+
+    do
+    {
+        para_set_fmt( editor, para, fmt );
+        if (para == para_end) break;
+        para = para_next( para );
+    } while(1);
+
+    ME_WrapMarkedParagraphs( editor );
+    ME_CommitUndo( editor );
+    return TRUE;
+}
+
 static void para_copy_fmt( const ME_Paragraph *para, PARAFORMAT2 *fmt )
 {
     UINT size = fmt->cbSize;
@@ -973,6 +1004,17 @@ void editor_set_default_para_fmt( ME_TextEditor *editor, PARAFORMAT2 *pFmt )
         /* Just use the alignment for now */
         if (host_fmt->dwMask & PFM_ALIGNMENT)
             pFmt->wAlignment = host_fmt->wAlignment;
-        ITextHost_OnTxParaFormatChange( editor->texthost, (PARAFORMAT *)pFmt );
+        /* The host is not told about this: it supplied the format itself, and
+         * hosts exist that treat OnTxParaFormatChange as "never called". */
     }
 }
+
+/* get the format of the first paragraph covered by a range of characters */
+void editor_get_range_para_fmt( ME_TextEditor *editor, int start, int end, PARAFORMAT2 *fmt )
+{
+    ME_Paragraph *para, *para_end;
+
+    editor_get_range_paras( editor, start, end, &para, &para_end );
+    fmt->cbSize = sizeof(*fmt);
+    para_copy_fmt( para, fmt );
+}
