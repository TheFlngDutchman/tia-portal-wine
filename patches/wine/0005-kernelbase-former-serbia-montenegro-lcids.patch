 {
     const NLS_LOCALE_DATA *locale = NlsValidateLocale( &lcid, flags );
 
+    if (!locale)
+    {
+        /* Windows still knows the locales of the former Serbia and Montenegro;
+         * Wine's locale data only has their successors. */
+        switch (lcid)
+        {
+        case 0x081a: lcid = 0x241a; break;  /* sr-Latn-CS -> sr-Latn-RS */
+        case 0x0c1a: lcid = 0x281a; break;  /* sr-Cyrl-CS -> sr-Cyrl-RS */
+        default: lcid = 0; break;
+        }
+        if (lcid) locale = NlsValidateLocale( &lcid, flags );
+    }
