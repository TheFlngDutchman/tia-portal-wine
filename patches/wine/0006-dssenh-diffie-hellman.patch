+/* Build the group from P and G and generate the private value. */
+static BOOL finish_dh_key( struct key *key )
+{
+    DWORD size = key->bitlen / 8;
+
+    if (key->handle) return TRUE;
+    if (!key->dh_p || !key->dh_g)
+    {
+        SetLastError( NTE_BAD_KEY_STATE );
+        return FALSE;
+    }
+    if (!(key->group = SymCryptDlgroupAllocate( key->bitlen, 0 ))) goto error;
+    if (SymCryptDlgroupSetValue( key->dh_p, size, NULL, 0, key->dh_g, size, SYMCRYPT_NUMBER_FORMAT_LSB_FIRST,
+                                 NULL, NULL, 0, 0, SYMCRYPT_DLGROUP_FIPS_NONE, key->group ))
+    {
+        WARN( "invalid group parameters\n" );
+        goto error;
+    }
+    if (!(key->handle = SymCryptDlkeyAllocate( key->group ))) goto error;
+    if (SymCryptDlkeyGenerate( SYMCRYPT_FLAG_KEY_NO_FIPS | SYMCRYPT_FLAG_DLKEY_DH, key->handle )) goto error;
+    return TRUE;
+
+error:
+    if (key->handle) SymCryptDlkeyFree( key->handle );
+    if (key->group) SymCryptDlgroupFree( key->group );
+    key->handle = NULL;
+    key->group = NULL;
+    SetLastError( NTE_BAD_DATA );
+    return FALSE;
+}
+
+static BOOL generate_dh_key( ALG_ID algid, DWORD bitlen, DWORD flags, HCRYPTKEY *ret_key )
+{
+    struct key *key;
+
+    if (!(key = create_key( algid, bitlen, flags ))) return FALSE;
+
+    /* With CRYPT_PREGEN the caller supplies P and G and then sets KP_X. */
+    if (!(flags & CRYPT_PREGEN))
+    {
+        if (!(key->group = SymCryptDlgroupAllocate( bitlen, 0 )) ||
+            SymCryptDlgroupGenerate( NULL, SYMCRYPT_DLGROUP_FIPS_186_2, key->group ) ||
+            !(key->handle = SymCryptDlkeyAllocate( key->group )) ||
+            SymCryptDlkeyGenerate( SYMCRYPT_FLAG_KEY_NO_FIPS | SYMCRYPT_FLAG_DLKEY_DH, key->handle ))
+        {
+            destroy_key( key );
+            SetLastError( NTE_FAIL );
+            return FALSE;
+        }
+    }
+
+    *ret_key = (HCRYPTKEY)key;
+    return TRUE;
+}
+
+static BOOL export_dh_public_key( const struct key *key, BYTE *output, DWORD output_len, DWORD *ret_len )
+{
+    DWORD size = key->bitlen / 8, len = sizeof(BLOBHEADER) + sizeof(DHPUBKEY) + size;
+    BLOBHEADER *hdr = (BLOBHEADER *)output;
+    DHPUBKEY *pubkey;
+
+    if (!key->handle)
+    {
+        SetLastError( NTE_BAD_KEY_STATE );
+        return FALSE;
+    }
+    *ret_len = len;
+    if (!output) return TRUE;
+    if (output_len < len)
+    {
+        SetLastError( ERROR_MORE_DATA );
+        return FALSE;
+    }
+
+    hdr->bType    = PUBLICKEYBLOB;
+    hdr->bVersion = 2;
+    hdr->reserved = 0;
+    hdr->aiKeyAlg = key->algid;
+    pubkey = (DHPUBKEY *)(hdr + 1);
+    pubkey->magic  = MAGIC_DH1;
+    pubkey->bitlen = key->bitlen;
+    if (SymCryptDlkeyGetValue( key->handle, NULL, 0, (BYTE *)(pubkey + 1), size,
+                               SYMCRYPT_NUMBER_FORMAT_LSB_FIRST, 0 ))
+    {
+        SetLastError( NTE_FAIL );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* Import the other party's public value and compute the agreed secret. */
+static BOOL import_dh_public_key( const BYTE *data, DWORD len, const struct key *own, DWORD flags,
+                                  HCRYPTKEY *ret_key )
+{
+    const BLOBHEADER *hdr = (const BLOBHEADER *)data;
+    const DHPUBKEY *pubkey = (const DHPUBKEY *)(hdr + 1);
+    SYMCRYPT_DLKEY *peer = NULL;
+    struct key *key = NULL;
+    DWORD size;
+
+    if (!own || own->magic != MAGIC_KEY || !is_dh_algid( own->algid ) || !own->handle)
+    {
+        SetLastError( NTE_BAD_KEY );
+        return FALSE;
+    }
+    size = own->bitlen / 8;
+    if (len < sizeof(*hdr) + sizeof(*pubkey) + size || pubkey->magic != MAGIC_DH1 || pubkey->bitlen != own->bitlen)
+    {
+        SetLastError( NTE_BAD_DATA );
+        return FALSE;
+    }
+
+    if (!(key = create_key( CALG_AGREEDKEY_ANY, own->bitlen, flags ))) return FALSE;
+    if (!(key->secret = calloc( 1, size ))) goto error;
+    key->secret_len = size;
+
+    if (!(peer = SymCryptDlkeyAllocate( own->group ))) goto error;
+    if (SymCryptDlkeySetValue( NULL, 0, (const BYTE *)(pubkey + 1), size, SYMCRYPT_NUMBER_FORMAT_LSB_FIRST,
+                               SYMCRYPT_FLAG_KEY_NO_FIPS | SYMCRYPT_FLAG_DLKEY_DH, peer )) goto error;
+    if (SymCryptDhSecretAgreement( own->handle, peer, SYMCRYPT_NUMBER_FORMAT_LSB_FIRST, 0,
+                                   key->secret, size )) goto error;
+
+    SymCryptDlkeyFree( peer );
+    *ret_key = (HCRYPTKEY)key;
+    return TRUE;
+
+error:
+    if (peer) SymCryptDlkeyFree( peer );
+    destroy_key( key );
+    SetLastError( NTE_BAD_DATA );
+    return FALSE;
+}
