+/* Turn the agreed Diffie-Hellman secret into a session key.
+ *
+ * NOTE: which bytes of the secret Windows uses is not documented and was not
+ * verified. Both ends of a link must therefore use this implementation: it is
+ * consistent with itself, but not known to interoperate with Windows. */
+static BOOL convert_agreed_key( struct key *key, ALG_ID algid )
+{
+    BYTE des_key[8] = {0};
+
+    switch (algid)
+    {
+    case CALG_CYLINK_MEK:   /* DES with 40 key bits; the remaining key bits are zero */
+        memcpy( des_key, key->secret, 5 );
+        break;
+    case CALG_DES:
+        memcpy( des_key, key->secret, 8 );
+        break;
+    default:
+        FIXME( "conversion to algorithm %08x not supported\n", algid );
+        SetLastError( NTE_BAD_ALGID );
+        return FALSE;
+    }
+
+    if (SymCryptDesExpandKey( &key->des, des_key, sizeof(des_key) ))
+    {
+        SetLastError( NTE_FAIL );
+        return FALSE;
+    }
+    SecureZeroMemory( des_key, sizeof(des_key) );
+    memset( key->iv, 0, sizeof(key->iv) );
+    memset( key->chain, 0, sizeof(key->chain) );
+    key->session_alg = algid;
+    key->have_cipher = TRUE;
+    TRACE( "agreed key converted to algorithm %08x\n", algid );
+    return TRUE;
+}
