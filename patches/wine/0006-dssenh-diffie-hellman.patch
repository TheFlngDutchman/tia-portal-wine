+BOOL WINAPI CPGetKeyParam( HCRYPTPROV hprov, HCRYPTKEY hkey, DWORD param, BYTE *data, DWORD *len, DWORD flags )
+{
+    struct key *key = (struct key *)hkey;
+    const BYTE *src;
+    DWORD value, size = sizeof(value);
+
+    TRACE( "%IX, %IX, %lu, %p, %p, %08lx\n", hprov, hkey, param, data, len, flags );
+
+    if (!key || key->magic != MAGIC_KEY || !len)
+    {
+        SetLastError( NTE_BAD_KEY );
+        return FALSE;
+    }
+
+    src = (const BYTE *)&value;
+    switch (param)
+    {
+    case KP_ALGID:
+        value = key->have_cipher ? key->session_alg : key->algid;
+        break;
+    case KP_KEYLEN:
+        if (!key->have_cipher) value = key->bitlen;
+        else value = (key->session_alg == CALG_CYLINK_MEK) ? 40 : 56;
+        break;
+    case KP_BLOCKLEN:
+        value = key->have_cipher ? 64 : key->bitlen;
+        break;
+    case KP_MODE:
+        value = CRYPT_MODE_CBC;
+        break;
+    case KP_PADDING:
+        value = PKCS5_PADDING;
+        break;
+    case KP_IV:
+        if (!key->have_cipher)
+        {
+            SetLastError( NTE_BAD_KEY );
+            return FALSE;
+        }
+        src = key->iv;
+        size = sizeof(key->iv);
+        break;
+    default:
+        FIXME( "%IX, %IX, %lu, %p, %p, %08lx: unsupported parameter\n", hprov, hkey, param, data, len, flags );
+        SetLastError( NTE_BAD_TYPE );
+        return FALSE;
+    }
+
+    if (data && *len < size)
+    {
+        *len = size;
+        SetLastError( ERROR_MORE_DATA );
+        return FALSE;
+    }
+    if (data) memcpy( data, src, size );
+    *len = size;
+    return TRUE;
+}
+
+/* CBC with PKCS#5 padding, which is what CryptoAPI uses for block ciphers by default. */
+BOOL WINAPI CPEncrypt( HCRYPTPROV hprov, HCRYPTKEY hkey, HCRYPTHASH hhash, BOOL final, DWORD flags, BYTE *data,
+                       DWORD *len, DWORD buflen )
+{
+    struct key *key = (struct key *)hkey;
+    DWORD in_len, out_len, pad;
+
+    TRACE( "%IX, %IX, %IX, %d, %08lx, %p, %p, %lu\n", hprov, hkey, hhash, final, flags, data, len, buflen );
+
+    if (!key || key->magic != MAGIC_KEY || !key->have_cipher || !len)
+    {
+        SetLastError( NTE_BAD_KEY );
+        return FALSE;
+    }
+    if (hhash) FIXME( "hashing the plaintext is not supported\n" );
+
+    in_len = *len;
+    if (final) out_len = (in_len / 8 + 1) * 8;
+    else if (in_len % 8)
+    {
+        SetLastError( NTE_BAD_LEN );
+        return FALSE;
+    }
+    else out_len = in_len;
+
+    if (!data)
+    {
+        *len = out_len;
+        return TRUE;
+    }
+    if (buflen < out_len)
+    {
+        *len = out_len;
+        SetLastError( ERROR_MORE_DATA );
+        return FALSE;
+    }
+
+    pad = out_len - in_len;
+    if (pad) memset( data + in_len, pad, pad );
+    SymCryptCbcEncrypt( SymCryptDesBlockCipher, &key->des, key->chain, data, data, out_len );
+    if (final) memcpy( key->chain, key->iv, sizeof(key->chain) );
+    *len = out_len;
+    return TRUE;
+}
+
+BOOL WINAPI CPDecrypt( HCRYPTPROV hprov, HCRYPTKEY hkey, HCRYPTHASH hhash, BOOL final, DWORD flags, BYTE *data,
+                       DWORD *len )
+{
+    struct key *key = (struct key *)hkey;
+    DWORD i, pad;
+
+    TRACE( "%IX, %IX, %IX, %d, %08lx, %p, %p\n", hprov, hkey, hhash, final, flags, data, len );
+
+    if (!key || key->magic != MAGIC_KEY || !key->have_cipher || !len || !data)
+    {
+        SetLastError( NTE_BAD_KEY );
+        return FALSE;
+    }
+    if (hhash) FIXME( "hashing the plaintext is not supported\n" );
+    if (!*len || *len % 8)
+    {
+        SetLastError( NTE_BAD_DATA );
+        return FALSE;
+    }
+
+    SymCryptCbcDecrypt( SymCryptDesBlockCipher, &key->des, key->chain, data, data, *len );
+    if (!final) return TRUE;
+
+    memcpy( key->chain, key->iv, sizeof(key->chain) );
+    pad = data[*len - 1];
+    if (!pad || pad > 8)
+    {
+        WARN( "invalid padding after decrypting %lu bytes\n", *len );
+        SetLastError( NTE_BAD_DATA );
+        return FALSE;
+    }
+    for (i = 0; i < pad; i++)
+    {
+        if (data[*len - 1 - i] != pad)
+        {
+            SetLastError( NTE_BAD_DATA );
+            return FALSE;
+        }
+    }
+    *len -= pad;
+    TRACE( "decrypted %lu bytes\n", *len );
+    return TRUE;
 }
 
 BOOL WINAPI CPGenRandom( HCRYPTPROV hprov, DWORD len, BYTE *buffer )
