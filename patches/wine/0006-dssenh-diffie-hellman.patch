+            SetLastError( NTE_BAD_DATA );
+            return FALSE;
+        }
+        return TRUE;
+
+    case KP_PADDING:
+        if (!data || *(const DWORD *)data != PKCS5_PADDING)
+        {
+            FIXME( "padding %lu not supported\n", data ? *(const DWORD *)data : 0 );
+            SetLastError( NTE_BAD_DATA );
+            return FALSE;
+        }
+        return TRUE;
+
+    default:
+        FIXME( "%IX, %IX, %lu, %p, %08lx: unsupported parameter\n", hprov, hkey, param, data, flags );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+}
