+
+    if (!key || key->magic != MAGIC_KEY)
+    {
+        SetLastError( NTE_BAD_KEY );
+        return FALSE;
+    }
+
+    switch (param)
+    {
+    case KP_P:
+    case KP_G:
+    {
+        const CRYPT_DATA_BLOB *blob = (const CRYPT_DATA_BLOB *)data;
+        DWORD size = key->bitlen / 8;
+        BYTE **dst = (param == KP_P) ? &key->dh_p : &key->dh_g;
+
+        if (!is_dh_algid( key->algid ) || key->handle)
+        {
