+            return FALSE;
+        }
+        if (!blob || !blob->pbData || !blob->cbData || blob->cbData > size)
+        {
+            SetLastError( NTE_BAD_DATA );
+            return FALSE;
+        }
+        free( *dst );
+        if (!(*dst = calloc( 1, size )))
+        {
+            SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+            return FALSE;
+        }
+        memcpy( *dst, blob->pbData, blob->cbData );
+        return TRUE;
+    }
+    case KP_X:
+        if (!is_dh_algid( key->algid ))
+        {
+            SetLastError( NTE_BAD_KEY );
+            return FALSE;
+        }
+        return finish_dh_key( key );
+
+    case KP_ALGID:
+        if (key->algid != CALG_AGREEDKEY_ANY || !data)
+        {
+            SetLastError( NTE_BAD_KEY );
+            return FALSE;
+        }
+        return convert_agreed_key( key, *(const ALG_ID *)data );
+
+    case KP_IV:
+        if (!key->have_cipher || !data)
+        {
+            SetLastError( NTE_BAD_KEY );
+            return FALSE;
+        }
+        memcpy( key->iv, data, sizeof(key->iv) );
+        memcpy( key->chain, data, sizeof(key->chain) );
+        return TRUE;
+
+    case KP_MODE:
+        if (!data || *(const DWORD *)data != CRYPT_MODE_CBC)
+        {
