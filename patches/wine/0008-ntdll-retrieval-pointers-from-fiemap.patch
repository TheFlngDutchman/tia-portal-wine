+/* Report where a file's data lies on its volume, in clusters, from the
+ * kernel's extent map. Returns STATUS_NOT_SUPPORTED if that is unavailable. */
+static NTSTATUS get_retrieval_pointers( int fd, LONGLONG start_vcn, RETRIEVAL_POINTERS_BUFFER *buffer,
+                                        ULONG out_size, ULONG *ret_size )
+{
+#ifdef FS_IOC_FIEMAP
+    enum { MAX_EXTENTS = 64 };
+    struct
+    {
+        struct fiemap        map;
+        struct fiemap_extent extents[MAX_EXTENTS];
+    } req;
+    const ULONG max_count = (out_size - offsetof( RETRIEVAL_POINTERS_BUFFER, Extents )) / sizeof(buffer->Extents[0]);
+    NTSTATUS status = STATUS_SUCCESS;
+    struct statfs stfs;
+    struct stat st;
+    ULONGLONG cluster, next_vcn;
+    ULONG i, count = 0;
+
+    if (start_vcn < 0) return STATUS_INVALID_PARAMETER;
+    if (fstat( fd, &st ) || !S_ISREG( st.st_mode )) return STATUS_NOT_SUPPORTED;
+    if (fstatfs( fd, &stfs ) || !stfs.f_bsize) return STATUS_NOT_SUPPORTED;
+    cluster = stfs.f_bsize;
+
+    memset( &req, 0, sizeof(req) );
+    req.map.fm_start        = (ULONGLONG)start_vcn * cluster;
+    req.map.fm_length       = ~(ULONGLONG)0;
+    req.map.fm_flags        = FIEMAP_FLAG_SYNC;
+    req.map.fm_extent_count = MAX_EXTENTS;
+    if (ioctl( fd, FS_IOC_FIEMAP, &req.map ) < 0) return STATUS_NOT_SUPPORTED;
+
+    /* no extent at or after the starting VCN, or data stored inside the file record */
+    if (!req.map.fm_mapped_extents) return STATUS_END_OF_FILE;
+    if (req.extents[0].fe_flags & (FIEMAP_EXTENT_DATA_INLINE | FIEMAP_EXTENT_NOT_ALIGNED))
+        return STATUS_END_OF_FILE;
+    if (req.extents[0].fe_flags & FIEMAP_EXTENT_UNKNOWN) return STATUS_NOT_SUPPORTED;
+
+    next_vcn = req.extents[0].fe_logical / cluster;
+    buffer->StartingVcn.QuadPart = next_vcn;
+
+    for (i = 0; i < req.map.fm_mapped_extents; i++)
+    {
+        const struct fiemap_extent *ext = &req.extents[i];
+        ULONGLONG vcn = ext->fe_logical / cluster;
+        ULONGLONG len = (ext->fe_length + cluster - 1) / cluster;
+
+        if (vcn > next_vcn)  /* hole: Windows reports it as an extent without clusters */
+        {
+            if (count >= max_count) { status = STATUS_BUFFER_OVERFLOW; break; }
+            buffer->Extents[count].NextVcn.QuadPart = vcn;
+            buffer->Extents[count].Lcn.QuadPart     = -1;
+            count++;
+        }
+        if (count >= max_count) { status = STATUS_BUFFER_OVERFLOW; break; }
+        buffer->Extents[count].NextVcn.QuadPart = vcn + len;
+        buffer->Extents[count].Lcn.QuadPart     = ext->fe_physical / cluster;
+        count++;
+        next_vcn = vcn + len;
+    }
+    if (!status && !(req.extents[req.map.fm_mapped_extents - 1].fe_flags & FIEMAP_EXTENT_LAST))
+        status = STATUS_BUFFER_OVERFLOW;
+
+    buffer->ExtentCount = count;
+    *ret_size = offsetof( RETRIEVAL_POINTERS_BUFFER, Extents[count] );
+    return status;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
