diff --git i/dlls/mshtml/conpoint.c w/dlls/mshtml/conpoint.c
index 95043e7..faaa872 100644
--- i/dlls/mshtml/conpoint.c
+++ w/dlls/mshtml/conpoint.c
@@ -397,6 +397,17 @@ static HRESULT WINAPI ConnectionPointContainer_EnumConnectionPoints(IConnectionP
         IEnumConnectionPoints **ppEnum)
 {
     ConnectionPointContainer *This = impl_from_IConnectionPointContainer(iface);
+    IConnectionPointContainer *plugin_container;
+
+    /* A host enumerating the connection points of an <object> element is
+     * looking for the events of the embedded control. */
+    if(This->get_plugin_container && SUCCEEDED(This->get_plugin_container(This, &plugin_container))) {
+        HRESULT hres = IConnectionPointContainer_EnumConnectionPoints(plugin_container, ppEnum);
+        TRACE("(%p)->(%p) forwarded to embedded control: %08lx\n", This, ppEnum, hres);
+        IConnectionPointContainer_Release(plugin_container);
+        return hres;
+    }
+
     FIXME("(%p)->(%p)\n", This, ppEnum);
     return E_NOTIMPL;
 }
@@ -414,6 +425,17 @@ static HRESULT WINAPI ConnectionPointContainer_FindConnectionPoint(IConnectionPo
                 riid, ppCP);
 
     cp = get_cp(This, riid, TRUE);
+    if(!cp && This->get_plugin_container) {
+        IConnectionPointContainer *plugin_container;
+
+        if(SUCCEEDED(This->get_plugin_container(This, &plugin_container))) {
+            HRESULT hres = IConnectionPointContainer_FindConnectionPoint(plugin_container, riid, ppCP);
+            TRACE("forwarded to embedded control: %08lx\n", hres);
+            IConnectionPointContainer_Release(plugin_container);
+            if(SUCCEEDED(hres))
+                return hres;
+        }
+    }
     if(!cp) {
         FIXME("unsupported riid %s\n", debugstr_mshtml_guid(riid));
         *ppCP = NULL;
diff --git i/dlls/mshtml/htmlobject.c w/dlls/mshtml/htmlobject.c
index be567e8..bc39387 100644
--- i/dlls/mshtml/htmlobject.c
+++ w/dlls/mshtml/htmlobject.c
@@ -656,6 +656,15 @@ static inline HTMLObjectElement *impl_from_DispatchEx(DispatchEx *iface)
     return CONTAINING_RECORD(iface, HTMLObjectElement, plugin_container.element.node.event_target.dispex);
 }
 
+static HRESULT HTMLObjectElement_get_plugin_container(ConnectionPointContainer *container, IConnectionPointContainer **ret)
+{
+    HTMLObjectElement *This = CONTAINING_RECORD(container, HTMLObjectElement, plugin_container.element.cp_container);
+
+    if(!This->plugin_container.plugin_host || !This->plugin_container.plugin_host->plugin_unk)
+        return E_FAIL;
+    return IUnknown_QueryInterface(This->plugin_container.plugin_host->plugin_unk, &IID_IConnectionPointContainer, (void**)ret);
+}
+
 static void *HTMLObjectElement_query_interface(DispatchEx *dispex, REFIID riid)
 {
     HTMLObjectElement *This = impl_from_DispatchEx(dispex);
@@ -778,6 +787,7 @@ HRESULT HTMLObjectElement_Create(HTMLDocumentNode *doc, nsIDOMElement *nselem, H
     ret->plugin_container.element.node.vtbl = &HTMLObjectElementImplVtbl;
 
     HTMLElement_Init(&ret->plugin_container.element, doc, nselem, &HTMLObjectElement_dispex);
+    ret->plugin_container.element.cp_container.get_plugin_container = HTMLObjectElement_get_plugin_container;
 
     nsres = nsIDOMElement_QueryInterface(nselem, &IID_nsIDOMHTMLObjectElement, (void**)&ret->nsobject);
     assert(nsres == NS_OK);
