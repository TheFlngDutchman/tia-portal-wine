+++ w/dlls/ncrypt/main.c
@@ -132,8 +132,54 @@ static SECURITY_STATUS set_object_property(struct object *object, const WCHAR *n
     return ERROR_SUCCESS;
 }
 
+struct ecdh_alg
+{
+    enum algid algid;
+    const WCHAR *name;
+    BCRYPT_ALG_HANDLE handle;
+    DWORD bitlen;
+    DWORD public_magic;
+    DWORD private_magic;
+};
+
+static const struct ecdh_alg ecdh_algs[] =
+{
+    { ECDH_P256, BCRYPT_ECDH_P256_ALGORITHM, BCRYPT_ECDH_P256_ALG_HANDLE, 256,
+      BCRYPT_ECDH_PUBLIC_P256_MAGIC, BCRYPT_ECDH_PRIVATE_P256_MAGIC },
+    { ECDH_P384, BCRYPT_ECDH_P384_ALGORITHM, BCRYPT_ECDH_P384_ALG_HANDLE, 384,
+      BCRYPT_ECDH_PUBLIC_P384_MAGIC, BCRYPT_ECDH_PRIVATE_P384_MAGIC },
+    { ECDH_P521, BCRYPT_ECDH_P521_ALGORITHM, BCRYPT_ECDH_P521_ALG_HANDLE, 521,
+      BCRYPT_ECDH_PUBLIC_P521_MAGIC, BCRYPT_ECDH_PRIVATE_P521_MAGIC },
+};
+
+static const struct ecdh_alg *get_ecdh_alg_from_name(const WCHAR *name)
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(ecdh_algs); i++)
+        if (!lstrcmpiW(name, ecdh_algs[i].name)) return &ecdh_algs[i];
+    return NULL;
+}
+
+static const struct ecdh_alg *get_ecdh_alg_from_magic(DWORD magic)
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(ecdh_algs); i++)
+        if (magic == ecdh_algs[i].public_magic || magic == ecdh_algs[i].private_magic) return &ecdh_algs[i];
+    return NULL;
+}
+
+static const struct ecdh_alg *get_ecdh_alg_from_id(enum algid algid)
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(ecdh_algs); i++)
+        if (algid == ecdh_algs[i].algid) return &ecdh_algs[i];
+    return NULL;
+}
+
 static struct object *create_key_object(enum algid algid, NCRYPT_PROV_HANDLE provider)
 {
+    static const WCHAR ecdh_group[] = L"ECDH";
+    const struct ecdh_alg *ecdh;
     NCRYPT_SUPPORTED_LENGTHS supported_lengths = {512, 16384, 8, 1024};
     struct object *object;
     DWORD dw_value;
@@ -162,6 +208,20 @@ static struct object *create_key_object(enum algid algid, NCRYPT_PROV_HANDLE pro
         object->key.algid = ECDSA_P256;
         break;
 
+    case ECDH_P256:
+    case ECDH_P384:
+    case ECDH_P521:
+        if (!(object = allocate_object(KEY))) return NULL;
+
+        ecdh = get_ecdh_alg_from_id(algid);
+        object->key.algid = algid;
+        set_object_property(object, NCRYPT_ALGORITHM_PROPERTY, (BYTE *)ecdh->name,
+                            (lstrlenW(ecdh->name) + 1) * sizeof(WCHAR));
+        set_object_property(object, NCRYPT_ALGORITHM_GROUP_PROPERTY, (BYTE *)ecdh_group, sizeof(ecdh_group));
+        set_object_property(object, NCRYPT_LENGTH_PROPERTY, (BYTE *)&ecdh->bitlen, sizeof(ecdh->bitlen));
+        set_object_property(object, BCRYPT_PUBLIC_KEY_LENGTH, (BYTE *)&ecdh->bitlen, sizeof(ecdh->bitlen));
+        break;
+
     default:
         ERR("Invalid algid %#x\n", algid);
         return NULL;
@@ -181,6 +241,7 @@ static struct object *create_key_object(enum algid algid, NCRYPT_PROV_HANDLE pro
 SECURITY_STATUS WINAPI NCryptCreatePersistedKey(NCRYPT_PROV_HANDLE provider, NCRYPT_KEY_HANDLE *key,
                                                 const WCHAR *algid, const WCHAR *name, DWORD keyspec, DWORD flags)
 {
+    const struct ecdh_alg *ecdh;
     struct object *object;
 
     TRACE("(%#Ix, %p, %s, %s, %#lx, %#lx)\n", provider, key, wine_dbgstr_w(algid),
@@ -230,6 +291,20 @@ SECURITY_STATUS WINAPI NCryptCreatePersistedKey(NCRYPT_PROV_HANDLE provider, NCR
         set_object_property(object, NCRYPT_LENGTH_PROPERTY, (BYTE *)&bitlen, sizeof(bitlen));
         set_object_property(object, BCRYPT_PUBLIC_KEY_LENGTH, (BYTE *)&bitlen, sizeof(bitlen));
     }
+    else if ((ecdh = get_ecdh_alg_from_name(algid)))
+    {
+        NTSTATUS status;
+
+        if (!(object = create_key_object(ecdh->algid, provider)))
+            return NTE_NO_MEMORY;
+
+        status = BCryptGenerateKeyPair(ecdh->handle, &object->key.bcrypt_key, ecdh->bitlen, 0);
+        if (status != STATUS_SUCCESS)
+        {
+            free(object);
+            return map_ntstatus(status);
+        }
+    }
     else
     {
         FIXME("Algorithm not handled %s\n", wine_dbgstr_w(algid));
@@ -308,7 +383,9 @@ SECURITY_STATUS WINAPI NCryptFinalizeKey(NCRYPT_KEY_HANDLE handle, DWORD flags)
 
     if (!(prop = get_object_property(object, NCRYPT_LENGTH_PROPERTY))) return NTE_INVALID_HANDLE;
     key_length = *(DWORD *)prop->value;
-    status = BCryptSetProperty(object->key.bcrypt_key, BCRYPT_KEY_LENGTH, (UCHAR *)&key_length, sizeof(key_length), 0);
+    /* The curve fixes the length of an ECDH key. */
+    if (get_ecdh_alg_from_id(object->key.algid)) status = STATUS_SUCCESS;
+    else status = BCryptSetProperty(object->key.bcrypt_key, BCRYPT_KEY_LENGTH, (UCHAR *)&key_length, sizeof(key_length), 0);
     if (status != STATUS_SUCCESS)
     {
         ERR("Error setting key length property\n");
@@ -362,6 +439,10 @@ SECURITY_STATUS WINAPI NCryptFreeObject(NCRYPT_HANDLE handle)
             return 0;
         break;
 
+    case SECRET:
+        if ((ret = map_ntstatus(BCryptDestroySecret(object->secret.bcrypt_secret)))) return ret;
+        break;
+
     default:
         WARN("invalid handle %#Ix\n", handle);
         return NTE_INVALID_HANDLE;
@@ -407,6 +488,7 @@ SECURITY_STATUS WINAPI NCryptImportKey(NCRYPT_PROV_HANDLE provider, NCRYPT_KEY_H
                                        BYTE *data, DWORD datasize, DWORD flags)
 {
     BCRYPT_KEY_BLOB *header = (BCRYPT_KEY_BLOB *)data;
+    const struct ecdh_alg *ecdh;
     struct object *object;
 
     TRACE("(%#Ix, %#Ix, %s, %p, %p, %p, %lu, %#lx)\n", provider, decrypt_key, wine_dbgstr_w(type),
@@ -461,6 +543,21 @@ SECURITY_STATUS WINAPI NCryptImportKey(NCRYPT_PROV_HANDLE provider, NCRYPT_KEY_H
         break;
     }
     default:
+        if ((ecdh = get_ecdh_alg_from_magic(header->Magic)))
+        {
+            NTSTATUS status;
+
+            if (!(object = create_key_object(ecdh->algid, provider))) return NTE_NO_MEMORY;
+
+            status = BCryptImportKeyPair(ecdh->handle, NULL, type, &object->key.bcrypt_key, data, datasize, 0);
+            if (status != STATUS_SUCCESS)
+            {
+                WARN("Error importing key pair %#lx\n", status);
+                free(object);
+                return map_ntstatus(status);
+            }
+            break;
+        }
         FIXME("Unhandled key magic %#lx\n", header->Magic);
         return NTE_INVALID_PARAMETER;
     }
@@ -617,3 +714,44 @@ SECURITY_STATUS WINAPI NCryptVerifySignature(NCRYPT_KEY_HANDLE handle, void *pad
     return map_ntstatus(BCryptVerifySignature(key_object->key.bcrypt_key, padding, hash, hash_size, signature,
                                               signature_size, flags));
 }
+
+SECURITY_STATUS WINAPI NCryptSecretAgreement(NCRYPT_KEY_HANDLE priv_key, NCRYPT_KEY_HANDLE pub_key,
+                                             NCRYPT_SECRET_HANDLE *secret, DWORD flags)
+{
+    struct object *priv = (struct object *)priv_key, *pub = (struct object *)pub_key, *object;
+    NTSTATUS status;
+
+    TRACE("(%#Ix, %#Ix, %p, %#lx)\n", priv_key, pub_key, secret, flags);
+
+    if (!priv || priv->type != KEY || !pub || pub->type != KEY) return NTE_INVALID_HANDLE;
+    if (!secret) return NTE_INVALID_PARAMETER;
+    if (flags & ~NCRYPT_SILENT_FLAG) FIXME("flags %#lx not supported\n", flags);
+
+    if (!(object = allocate_object(SECRET))) return NTE_NO_MEMORY;
+
+    status = BCryptSecretAgreement(priv->key.bcrypt_key, pub->key.bcrypt_key, &object->secret.bcrypt_secret, 0);
+    if (status != STATUS_SUCCESS)
+    {
+        WARN("Secret agreement failed %#lx\n", status);
+        free(object);
+        return map_ntstatus(status);
+    }
+
+    *secret = (NCRYPT_SECRET_HANDLE)object;
+    return ERROR_SUCCESS;
+}
+
+SECURITY_STATUS WINAPI NCryptDeriveKey(NCRYPT_SECRET_HANDLE handle, const WCHAR *kdf, NCryptBufferDesc *params,
+                                       BYTE *output, DWORD output_len, DWORD *ret_len, ULONG flags)
+{
+    struct object *object = (struct object *)handle;
+
+    TRACE("(%#Ix, %s, %p, %p, %lu, %p, %#lx)\n", handle, wine_dbgstr_w(kdf), params, output, output_len,
+          ret_len, flags);
+
+    if (!object || object->type != SECRET) return NTE_INVALID_HANDLE;
+
+    /* NCryptBufferDesc and BCryptBufferDesc have the same layout. */
+    return map_ntstatus(BCryptDeriveKey(object->secret.bcrypt_secret, kdf, (BCryptBufferDesc *)params,
+                                        output, output_len, ret_len, flags & ~NCRYPT_SILENT_FLAG));
+}
