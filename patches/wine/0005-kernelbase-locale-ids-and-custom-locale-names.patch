+/* a language tag of two or three letters, optionally followed by subtags */
+static BOOL is_wellformed_locale_name( const WCHAR *name )
+{
+    unsigned int i, letters = 0;
+
+    if (!name || name == LOCALE_NAME_USER_DEFAULT) return FALSE;
+    while ((name[letters] >= 'a' && name[letters] <= 'z') || (name[letters] >= 'A' && name[letters] <= 'Z')) letters++;
+    if (letters < 2 || letters > 3) return FALSE;
+    for (i = letters; name[i]; i++)
+    {
+        WCHAR c = name[i];
+        if (i >= LOCALE_NAME_MAX_LENGTH - 1) return FALSE;
+        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-')) return FALSE;
+    }
+    return !name[letters] || name[letters] == '-';
+}
+
