     TRACE( "%s 0x%lx %p %d\n", debugstr_w(name), info, buffer, len );
 
+    /* Since Windows 10 any well-formed name is accepted as a custom locale:
+     * it keeps its own name and otherwise behaves like the invariant locale. */
+    if (!locale && is_wellformed_locale_name( name ))
+    {
+        WCHAR str[LOCALE_NAME_MAX_LENGTH + 32];
+        const WCHAR *ret = NULL;
+        unsigned int i;
+
+        switch (info & 0xffff)
+        {
+        case LOCALE_SNAME:
+            ret = name;
+            break;
+        case LOCALE_SISO639LANGNAME:
+        case LOCALE_SISO639LANGNAME2:
+            for (i = 0; name[i] && name[i] != '-'; i++) str[i] = name[i];
+            str[i] = 0;
+            ret = str;
+            break;
+        case LOCALE_SENGLISHDISPLAYNAME:
+        case LOCALE_SNATIVEDISPLAYNAME:
+        case LOCALE_SLOCALIZEDDISPLAYNAME:
+        case LOCALE_SENGLISHLANGUAGENAME:
+        case LOCALE_SNATIVELANGUAGENAME:
+        case LOCALE_SLOCALIZEDLANGUAGENAME:
+            swprintf( str, ARRAY_SIZE(str), L"Unknown Language (%s)", name );
+            ret = str;
+            break;
+        case LOCALE_ILANGUAGE:
+            if (info & LOCALE_RETURN_NUMBER)
+            {
+                DWORD value = LOCALE_CUSTOM_UNSPECIFIED;
+
+                if (!len) return sizeof(value) / sizeof(WCHAR);
+                if (!buffer || len < sizeof(value) / sizeof(WCHAR))
+                {
+                    SetLastError( ERROR_INSUFFICIENT_BUFFER );
+                    return 0;
+                }
+                memcpy( buffer, &value, sizeof(value) );
+                return sizeof(value) / sizeof(WCHAR);
+            }
+            ret = L"1000";
+            break;
+        }
+        if (ret)
+        {
+            INT needed = lstrlenW( ret ) + 1;
+
+            if (!len) return needed;
+            if (!buffer || len < needed)
+            {
+                SetLastError( ERROR_INSUFFICIENT_BUFFER );
+                return 0;
+            }
+            memcpy( buffer, ret, needed * sizeof(WCHAR) );
+            return needed;
+        }
+        if ((locale = get_locale_by_name( L"", &lcid ))) lcid = LOCALE_CUSTOM_UNSPECIFIED;
+    }
+
     if (!locale)
     {
         SetLastError( ERROR_INVALID_PARAMETER );
