+            {
+                SetLastError( ERROR_INSUFFICIENT_BUFFER );
+                return 0;
+            }
+            memcpy( buffer, name, needed * sizeof(WCHAR) );
+            return needed;
+        }
+        if ((locale = get_locale_by_name( L"", &lcid ))) lcid = LOCALE_CUSTOM_UNSPECIFIED;
+    }
+
     if (!locale)
     {
         SetLastError( ERROR_INVALID_PARAMETER );
