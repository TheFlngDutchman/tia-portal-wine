     TRACE( "%s 0x%lx %p %d\n", debugstr_w(name), info, buffer, len );
 
+    /* Since Windows 10 any well-formed name is accepted as a custom locale:
+     * it keeps its own name and otherwise behaves like the invariant locale. */
+    if (!locale && is_wellformed_locale_name( name ))
+    {
+        if ((info & 0xffff) == LOCALE_SNAME)
+        {
+            INT needed = lstrlenW( name ) + 1;
