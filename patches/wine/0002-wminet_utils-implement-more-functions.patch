     return error_info;
 }
+
+HRESULT WINAPI SetSecurity(BOOL *pNeedtoReset, HANDLE *pHandle)
+{
+    /* Native enables all privileges on the calling thread and returns a
+     * token to restore them later. Wine has no privilege checks to satisfy. */
+    TRACE("%p %p\n", pNeedtoReset, pHandle);
+
+    if (pNeedtoReset) *pNeedtoReset = FALSE;
+    if (pHandle) *pHandle = NULL;
+    return S_OK;
+}
+
+HRESULT WINAPI ResetSecurity(HANDLE handle)
+{
+    TRACE("%p\n", handle);
+    return S_OK;
+}
+
+HRESULT WINAPI BlessIWbemServices(IWbemServices *pIUnknown, BSTR strUser, void *password,
+    BSTR strAuthority, DWORD impLevel, DWORD authLevel)
+{
+    FIXME("%p %s %p %s %lx %lx: semi-stub\n", pIUnknown, debugstr_w(strUser), password,
+        debugstr_w(strAuthority), impLevel, authLevel);
+    return S_OK;
+}
+
+HRESULT WINAPI BlessIWbemServicesObject(IUnknown *pIUnknown, BSTR strUser, void *password,
+    BSTR strAuthority, DWORD impLevel, DWORD authLevel)
+{
+    FIXME("%p %s %p %s %lx %lx: semi-stub\n", pIUnknown, debugstr_w(strUser), password,
+        debugstr_w(strAuthority), impLevel, authLevel);
+    return S_OK;
+}
+
+HRESULT WINAPI Clone(int vFunc, IWbemClassObject *ptr, IWbemClassObject **ppCopy)
+{
+    TRACE("%i %p %p\n", vFunc, ptr, ppCopy);
+    return IWbemClassObject_Clone(ptr, ppCopy);
+}
+
+HRESULT WINAPI SpawnInstance(int vFunc, IWbemClassObject *ptr, LONG lFlags, IWbemClassObject **ppNewInstance)
+{
+    TRACE("%i %p %lx %p\n", vFunc, ptr, lFlags, ppNewInstance);
+    return IWbemClassObject_SpawnInstance(ptr, lFlags, ppNewInstance);
+}
+
+HRESULT WINAPI GetQualifierSet(int vFunc, IWbemClassObject *ptr, IWbemQualifierSet **ppQualSet)
+{
+    TRACE("%i %p %p\n", vFunc, ptr, ppQualSet);
+    return IWbemClassObject_GetQualifierSet(ptr, ppQualSet);
+}
+
+HRESULT WINAPI EndEnumeration(int vFunc, IWbemClassObject *ptr)
+{
+    TRACE("%i %p\n", vFunc, ptr);
+    return IWbemClassObject_EndEnumeration(ptr);
+}
+
+HRESULT WINAPI InheritsFrom(int vFunc, IWbemClassObject *ptr, LPCWSTR strAncestor)
+{
+    TRACE("%i %p %s\n", vFunc, ptr, debugstr_w(strAncestor));
+    return IWbemClassObject_InheritsFrom(ptr, strAncestor);
+}
+
+HRESULT WINAPI CompareTo(int vFunc, IWbemClassObject *ptr, LONG lFlags, IWbemClassObject *pCompareTo)
+{
+    TRACE("%i %p %lx %p\n", vFunc, ptr, lFlags, pCompareTo);
+    return IWbemClassObject_CompareTo(ptr, lFlags, pCompareTo);
+}
