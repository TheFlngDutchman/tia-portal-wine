 /* fetch the attributes of a file */
+#ifdef __linux__
+/* What an NTFS volume itself records about a file: the sequence number of its
+ * file record, its creation time and its attribute flags. The kernel's ntfs3
+ * driver uses the MFT record number as inode number but does not expose the
+ * sequence number, so the record is read from the volume's block device.
+ * Needs read access to that device; without it nothing changes. */
+struct ntfs_volume
+{
+    dev_t        dev;
+    int          fd;        /* -1: not NTFS, or the device cannot be read */
+    unsigned int sector, cluster, record;
+    unsigned int nb_runs;
+    struct { ULONGLONG lcn, len; } runs[32];    /* extents of $MFT */
+};
+
+struct ntfs_file_facts
+{
+    ULONGLONG reference;    /* (sequence number << 48) | record number */
+    ULONGLONG creation;     /* FILETIME */
+    ULONG     attributes;
+};
+
+static struct ntfs_volume ntfs_volumes[8];
+static unsigned int ntfs_volume_count;
+static pthread_mutex_t ntfs_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static ULONGLONG ntfs_le( const unsigned char *p, unsigned int size )
+{
+    ULONGLONG ret = 0;
+    while (size--) ret = (ret << 8) | p[size];
+    return ret;
+}
+
+static BOOL ntfs_read_record( const struct ntfs_volume *vol, ULONGLONG number, unsigned char *rec )
+{
+    ULONGLONG offset = number * vol->record;
+    unsigned int i, usa_ofs, usa_count;
+
+    for (i = 0; i < vol->nb_runs; i++)
+    {
+        ULONGLONG size = vol->runs[i].len * vol->cluster;
+        if (offset < size) break;
+        offset -= size;
+    }
+    if (i == vol->nb_runs) return FALSE;
+    if (pread( vol->fd, rec, vol->record, vol->runs[i].lcn * vol->cluster + offset ) != vol->record) return FALSE;
+    if (memcmp( rec, "FILE", 4 )) return FALSE;
+
+    /* undo the update sequence array */
+    usa_ofs = ntfs_le( rec + 4, 2 );
+    usa_count = ntfs_le( rec + 6, 2 );
+    for (i = 1; i < usa_count; i++)
+    {
+        if (i * vol->sector > vol->record || usa_ofs + 2 * i + 2 > vol->record) return FALSE;
+        memcpy( rec + i * vol->sector - 2, rec + usa_ofs + 2 * i, 2 );
+    }
+    return TRUE;
+}
+
+/* find an attribute in a file record; returns its offset or 0 */
+static unsigned int ntfs_find_attribute( const struct ntfs_volume *vol, const unsigned char *rec, ULONG type )
+{
+    unsigned int pos = ntfs_le( rec + 20, 2 );
+
+    while (pos + 16 <= vol->record)
+    {
+        ULONG atype = ntfs_le( rec + pos, 4 ), alen = ntfs_le( rec + pos + 4, 4 );
+        if (atype == 0xffffffff || !alen || pos + alen > vol->record) break;
+        if (atype == type && !rec[pos + 9] /* unnamed */) return pos;
+        pos += alen;
+    }
+    return 0;
+}
+
+static void ntfs_open_volume( struct ntfs_volume *vol, dev_t dev )
+{
+    unsigned char boot[512], rec[4096];
+    char path[64], line[128], devname[64] = "";
+    unsigned int pos, runs_pos;
+    LONGLONG lcn = 0;
+    FILE *f;
+    int c;
+
+    memset( vol, 0, sizeof(*vol) );
+    vol->dev = dev;
+    vol->fd  = -1;
+
+    snprintf( path, sizeof(path), "/sys/dev/block/%u:%u/uevent", major(dev), minor(dev) );
+    if (!(f = fopen( path, "r" ))) return;
+    while (fgets( line, sizeof(line), f ))
+        if (!strncmp( line, "DEVNAME=", 8 )) snprintf( devname, sizeof(devname), "/dev/%s", line + 8 );
+    fclose( f );
+    devname[strcspn( devname, "\n" )] = 0;
+    if (!devname[0]) return;
+
+    if ((vol->fd = open( devname, O_RDONLY | O_CLOEXEC )) == -1) return;
+    if (pread( vol->fd, boot, sizeof(boot), 0 ) != sizeof(boot) || memcmp( boot + 3, "NTFS    ", 8 )) goto failed;
+
+    vol->sector  = ntfs_le( boot + 11, 2 );
+    vol->cluster = vol->sector * boot[13];
+    c = (signed char)boot[64];
+    vol->record  = c < 0 ? 1u << -c : c * vol->cluster;
+    if (!vol->sector || !vol->cluster || !vol->record || vol->record > sizeof(rec)) goto failed;
+
+    /* bootstrap: record 0 describes $MFT itself */
+    vol->runs[0].lcn = ntfs_le( boot + 48, 8 );
+    vol->runs[0].len = (vol->record + vol->cluster - 1) / vol->cluster;
+    vol->nb_runs = 1;
+    if (!ntfs_read_record( vol, 0, rec )) goto failed;
+    if (!(pos = ntfs_find_attribute( vol, rec, 0x80 )) || !rec[pos + 8] /* resident */) goto failed;
+
+    vol->nb_runs = 0;
+    runs_pos = pos + ntfs_le( rec + pos + 32, 2 );
+    while (runs_pos < vol->record && rec[runs_pos] && vol->nb_runs < ARRAY_SIZE(vol->runs))
+    {
+        unsigned int len_size = rec[runs_pos] & 0xf, ofs_size = rec[runs_pos] >> 4;
+        ULONGLONG len, raw;
+
+        if (runs_pos + 1 + len_size + ofs_size > vol->record || len_size > 8 || ofs_size > 8 || !ofs_size) goto failed;
+        len = ntfs_le( rec + runs_pos + 1, len_size );
+        raw = ntfs_le( rec + runs_pos + 1 + len_size, ofs_size );
+        if (ofs_size < 8 && (raw >> (ofs_size * 8 - 1))) raw |= ~(ULONGLONG)0 << (ofs_size * 8);  /* sign extend */
+        lcn += (LONGLONG)raw;
+        vol->runs[vol->nb_runs].lcn = lcn;
+        vol->runs[vol->nb_runs].len = len;
+        vol->nb_runs++;
+        runs_pos += 1 + len_size + ofs_size;
+    }
+    if (vol->nb_runs) return;
+
+failed:
+    close( vol->fd );
+    vol->fd = -1;
+}
+
+static BOOL ntfs_get_file_facts( const struct stat *st, struct ntfs_file_facts *facts )
+{
+    struct ntfs_volume *vol = NULL;
+    unsigned char rec[4096];
+    unsigned int i, pos, body;
+    BOOL ret = FALSE;
+
+    pthread_mutex_lock( &ntfs_mutex );
+    for (i = 0; i < ntfs_volume_count; i++)
+        if (ntfs_volumes[i].dev == st->st_dev) vol = &ntfs_volumes[i];
+    if (!vol && ntfs_volume_count < ARRAY_SIZE(ntfs_volumes))
+    {
+        vol = &ntfs_volumes[ntfs_volume_count++];
+        ntfs_open_volume( vol, st->st_dev );
+    }
+    if (vol && vol->fd != -1 && ntfs_read_record( vol, st->st_ino, rec ) &&
+        (pos = ntfs_find_attribute( vol, rec, 0x10 )) && !rec[pos + 8])
+    {
+        body = pos + ntfs_le( rec + pos + 20, 2 );
+        if (body + 36 <= vol->record)
+        {
+            facts->reference  = (ntfs_le( rec + 16, 2 ) << 48) | st->st_ino;
+            facts->creation   = ntfs_le( rec + body, 8 );
+            facts->attributes = ntfs_le( rec + body + 32, 4 );
+            ret = TRUE;
+        }
+    }
+    pthread_mutex_unlock( &ntfs_mutex );
+    return ret;
+}
+#endif  /* __linux__ */
+
+/* the number Windows calls the file index / file ID */
+static ULONGLONG get_file_index( const struct stat *st )
+{
+#ifdef __linux__
+    struct ntfs_file_facts facts;
+    if (ntfs_get_file_facts( st, &facts )) return facts.reference;
+#endif
+    return st->st_ino;
+}
+
 static inline ULONG get_file_attributes( const struct stat *st )
 {
     ULONG attr;
